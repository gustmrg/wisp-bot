  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.314",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.0.13",
    "ignore": "7.0.14",
    "pdfjs-dist": "6.4.299",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  }
}
