{
  "name": "@gustmrg/wisp-server",
  "version": "0.0.0",
  "description": "Headless Wisp server: the Wisp backend behind authenticated HTTP.",
  "license": "MIT",
  "homepage": "https://github.com/gustmrg/wisp-bot/blob/main/docs/remote-server.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustmrg/wisp-bot.git",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/gustmrg/wisp-bot/issues"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "bin": {
