# Use absolute paths, without shell expansion. Run as the same Unix account as SSH.
WISP_DATA_DIR=/home/wisp/.local/share/wisp
WISP_HOST=127.0.0.1
WISP_PORT=8787
WISP_OWNER_NAME=Owner
WISP_TIMEZONE=America/Fortaleza
WISP_WEB_ROOT=/home/wisp/.local/lib/wisp/web
# Set to the exact origin printed by tailscale serve for web/mobile access:
# WISP_PUBLIC_ORIGIN=https://raspberrypi.example-tailnet.ts.net
# Capacitor bearer origins only; enable when using the native mobile client:
# WISP_ALLOWED_ORIGINS=capacitor://localhost,https://localhost
