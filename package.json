{
  "name": "wisp-bot",
  "version": "0.26.0",
  "description": "Wisp Bot gives you a squad of AI agents that work around the clock and actually get things done.",
  "homepage": "https://github.com/gustmrg/wisp-bot#readme",
  "bugs": {
    "url": "https://github.com/gustmrg/wisp-bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustmrg/wisp-bot.git"
  },
  "license": "MIT",
  "author": "Gustavo Miranda",
  "type": "commonjs",
  "main": "dist-electron/electron/main.js",
  "desktopName": "wisp-bot.desktop",
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "cross-env VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite --configLoader bundle",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && npm run build:electron && cross-env ELECTRON_RUN_AS_NODE= VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron && npm run build:server && npm run build:web",
    "build:renderer": "cross-env VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --configLoader bundle",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "release": "npm run build && electron-builder --publish always",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.vite.json --noEmit",
    "start": "npm run build && electron .",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node dist-server/server/main.js",
    "package:server": "node -e \"require('fs').rmSync('dist-server',{recursive:true,force:true})\" && npm run build:server && npm run build:web && node scripts/package-server.mjs",
    "build:web": "cross-env VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --config vite.web.config.mts --configLoader bundle",
    "dev:web": "cross-env VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite --config vite.web.config.mts --configLoader bundle",
    "smoke:pi": "npm run build:electron && node scripts/pi-live-smoke.mjs",
    "preview": "vite preview",
    "ui:add": "cross-env npm_config_allow_scripts= shadcn add"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.314",
    "@base-ui/react": "^1.9.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "6.8.11",
    "ignore": "7.0.14",
    "lucide-react": "^1.64.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "26.18.1",
    "jsdom": "30.1.3",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "^8.12.3"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "build": {
    "appId": "com.gustavomiranda.wispbot",
    "productName": "Wisp Bot",
    "artifactName": "Wisp-Bot-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-web/**/*",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*{,/**/*}"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "14.0.0",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Wisp Bot uses the microphone to transcribe your voice into messages."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icons",
      "category": "Utility",
      "executableName": "wisp-bot",
      "maintainer": "Gustavo Miranda",
      "synopsis": "A squad of AI agents that get things done.",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "syncDesktopName": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "publish": {
      "provider": "github",
      "owner": "gustmrg",
      "repo": "wisp-bot",
      "releaseType": "draft"
    },
    "generateUpdatesFilesForAllChannels": true
  }
}
