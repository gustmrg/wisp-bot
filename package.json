{
  "name": "wisp-bot",
  "version": "0.6.0",
  "description": "Wisp Bot gives you a squad of AI agents that work around the clock and actually get things done.",
  "homepage": "https://github.com/gustmrg/wisp-bot#readme",
  "bugs": {
    "url": "https://github.com/gustmrg/wisp-bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustmrg/wisp-bot.git"
  },
  "license": "MIT",
  "author": "Gustavo Miranda",
  "type": "commonjs",
  "main": "dist-electron/electron/main.js",
  "desktopName": "wisp-bot.desktop",
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --configLoader bundle",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && npm run build:electron && cross-env ELECTRON_RUN_AS_NODE= VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron && npm run build:server && npm run build:web",
    "build:renderer": "vite build --configLoader bundle",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "release": "npm run build && electron-builder --publish always",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.vite.json --noEmit",
    "start": "npm run build && electron .",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node dist-server/server/main.js",
    "package:server": "node -e \"require('fs').rmSync('dist-server',{recursive:true,force:true})\" && npm run build:server && npm run build:web && node scripts/package-server.mjs",
    "build:web": "vite build --config vite.web.config.mts --configLoader bundle",
    "dev:web": "vite --config vite.web.config.mts --configLoader bundle",
    "smoke:pi": "npm run build:electron && node scripts/pi-live-smoke.mjs",
    "preview": "vite preview",
    "ui:add": "cross-env npm_config_allow_scripts= shadcn add"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "6.8.9",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "26.15.3",
    "jsdom": "30.0.1",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "build": {
    "appId": "com.gustavomiranda.wispbot",
    "productName": "Wisp Bot",
    "artifactName": "Wisp-Bot-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Wisp Bot uses the microphone to transcribe your voice into messages."
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icons",
      "category": "Utility",
      "executableName": "wisp-bot",
      "maintainer": "Gustavo Miranda",
      "synopsis": "A squad of AI agents that get things done.",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "syncDesktopName": true
    },
    "publish": {
      "provider": "github",
      "owner": "gustmrg",
      "repo": "wisp-bot",
      "releaseType": "draft"
    },
    "generateUpdatesFilesForAllChannels": true
  }
}
