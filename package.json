{
  "name": "wisp-bot",
  "version": "0.1.0",
  "description": "Wisp Bot gives you a squad of AI agents that work around the clock and actually get things done.",
  "homepage": "https://github.com/gustmrg/wisp-bot#readme",
  "bugs": {
    "url": "https://github.com/gustmrg/wisp-bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustmrg/wisp-bot.git"
  },
  "license": "MIT",
  "author": "",
  "type": "commonjs",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.vite.json --noEmit",
    "start": "npm run build && electron .",
    "smoke:pi": "npm run build:electron && node scripts/pi-live-smoke.mjs",
    "preview": "vite preview",
    "ui:add": "cross-env npm_config_allow_scripts= shadcn add"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "jsdom": "30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
