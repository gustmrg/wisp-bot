  "google-calendar": {
    "google_calendar_list_calendars": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "google_calendar_list_events": {
      "type": "object",
      "properties": {
        "calendarId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Calendar ID from google_calendar_list_calendars; defaults to \"primary\", the user's main calendar."
        },
        "timeMin": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "Earliest end time, as a date-time with an offset (2026-10-20T00:00:00-03:00)."
        },
        "timeMax": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "Latest start time, as a date-time with an offset."
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Free text to match."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Events per page, 20 by default."
        },
        "pageToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "nextPageToken from a previous call."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "google_calendar_get_event": {
      "type": "object",
      "properties": {
        "calendarId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Calendar ID from google_calendar_list_calendars; defaults to \"primary\", the user's main calendar."
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Event ID."
        }
      },
      "required": ["eventId"],
      "additionalProperties": false
    },
    "google_calendar_free_busy": {
      "type": "object",
      "properties": {
        "timeMin": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "Start of the range, as a date-time with an offset."
        },
        "timeMax": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "End of the range, as a date-time with an offset; at most 31 days after timeMin."
        },
        "calendarIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": "Calendars to check; defaults to [\"primary\"]."
        }
      },
      "required": ["timeMin", "timeMax"],
      "additionalProperties": false
    },
    "google_calendar_create_event": {
      "type": "object",
      "properties": {
        "calendarId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Calendar ID from google_calendar_list_calendars; defaults to \"primary\", the user's main calendar."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Title."
        },
        "start": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "Start: a date or a date-time."
        },
        "end": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "End: a date (exclusive) or a date-time."
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "IANA time zone for date-times without an offset, such as America/Sao_Paulo."
        },
        "description": {
          "type": "string",
          "maxLength": 8000,
          "description": "Details, as plain text."
        },
        "location": {
          "type": "string",
          "maxLength": 500,
          "description": "Place or address."
        },
        "attendees": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320
          },
          "description": "Attendee email addresses."
        },
        "notifyAttendees": {
          "type": "boolean",
          "description": "Email the attendees about this change. Defaults to false; set it only when the user asked."
        }
      },
      "required": ["summary", "start", "end"],
      "additionalProperties": false
    },
    "google_calendar_update_event": {
      "type": "object",
      "properties": {
        "calendarId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Calendar ID from google_calendar_list_calendars; defaults to \"primary\", the user's main calendar."
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Event ID."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "New title."
        },
        "start": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "New start: a date or a date-time; give end too."
        },
        "end": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "New end: a date (exclusive) or a date-time; give start too."
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "IANA time zone for date-times without an offset, such as America/Sao_Paulo."
        },
        "description": {
          "type": "string",
          "maxLength": 8000,
          "description": "New details; an empty string clears them."
        },
        "location": {
          "type": "string",
          "maxLength": 500,
          "description": "New place; an empty string clears it."
        },
        "attendees": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320
          },
          "description": "Attendee email addresses."
        },
        "notifyAttendees": {
          "type": "boolean",
          "description": "Email the attendees about this change. Defaults to false; set it only when the user asked."
        }
      },
      "required": ["eventId"],
      "additionalProperties": false
    },
    "google_calendar_respond_to_event": {
      "type": "object",
      "properties": {
        "calendarId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Calendar ID from google_calendar_list_calendars; defaults to \"primary\", the user's main calendar."
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Event ID."
        },
        "response": {
          "type": "string",
          "enum": ["accepted", "declined", "tentative"],
          "description": "The answer."
        },
        "notifyOrganizer": {
          "type": "boolean",
          "description": "Email the organizer about the answer. Defaults to false; set it only when the user asked."
        }
      },
      "required": ["eventId", "response"],
      "additionalProperties": false
    }
  },
