        },
        "addLabelIds": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": "Label UUIDs to add, from linear_list_labels."
        },
        "removeLabelIds": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": "Label UUIDs to remove."
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "linear_add_comment": {
      "type": "object",
      "properties": {
        "issueId": {
          "type": "string",
          "minLength": 1,
