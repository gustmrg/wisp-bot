{
  "web-search": {
    "web_search": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Search query, at most 75 words."
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5
        }
      },
      "required": ["query"],
      "additionalProperties": false
    }
  },
  "linear": {
    "linear_search_issues": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Text to find in title or description."
        },
        "teamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Team UUID from linear_list_teams."
        },
        "stateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Status UUID from linear_list_statuses for the issue's team."
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Project UUID from linear_list_projects."
        },
        "labelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Label UUID from linear_list_labels; matches issues that have this label."
        },
        "assigneeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User UUID from linear_list_users, \"me\" for the connected user, or \"none\" for unassigned."
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Parent issue UUID or identifier (ENG-123); lists its sub-issues."
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "0 none, 1 urgent, 2 high, 3 normal, 4 low."
        },
        "updatedSince": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Only issues updated since an ISO 8601 date/date-time or duration, for example -P7D."
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Cursor from the previous result's pageInfo.endCursor."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 10
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "linear_get_issue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
