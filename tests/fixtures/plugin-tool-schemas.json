    "linear_create_issue": {
      "type": "object",
      "properties": {
        "teamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Team UUID from linear_list_teams."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Issue title."
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20000,
          "description": "Issue description in Markdown. Empty string clears it."
        },
        "stateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Status UUID from linear_list_statuses for the issue's team."
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "0 none, 1 urgent, 2 high, 3 normal, 4 low."
        },
        "assigneeId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "User UUID from linear_list_users."
        },
        "projectId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "Project UUID from linear_list_projects."
        },
        "parentId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "Parent issue UUID (the id returned by Linear issue tools)."
        },
        "estimate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Estimate points on the team's scale."
        },
        "dueDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "description": "Due date as YYYY-MM-DD."
        },
        "labelIds": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": "Label UUIDs from linear_list_labels."
        }
      },
      "required": ["teamId", "title"],
      "additionalProperties": false
    },
    "linear_update_issue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
